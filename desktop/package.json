{
  "name": "pathawk",
  "private": true,
  "version": "0.0.0",
  "description": "Pathawk — клиент (Electron + UI из pathawk-web)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev --prefix ../web\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DISABLE_SANDBOX=1 NODE_ENV=development electron .\"",
    "generate:icon": "node scripts/generate-icon.mjs",
    "build:agent": "node scripts/build-agent.mjs",
    "build:renderer": "npm run build --prefix ../web && node scripts/prepare-renderer.mjs",
    "build:pack": "npm run build:agent && npm run build:renderer",
    "start:prod": "cross-env ELECTRON_DISABLE_SANDBOX=1 NODE_ENV=production electron ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.2",
    "wait-on": "^8.0.1",
    "@resvg/resvg-js": "^2.6.2"
  }
}
